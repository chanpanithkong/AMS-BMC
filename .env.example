# API mode: "mock" runs the in-browser MSW backend with seeded demo data; "live" calls the FastAPI service.
NEXT_PUBLIC_API_MODE=mock

# Base URL of the backend API (SRS §13.1). In mock mode requests to this path are intercepted by MSW.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Idle timeout before automatic sign-out (SRS FR-AUTH-002 proposes 30 minutes).
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=30

# Amount (base currency) above which critical actions need the "I confirm" checkbox (SRS SCR-06).
NEXT_PUBLIC_CONFIRM_THRESHOLD=10000

# Feature flag for the optional Inventory Integration menu (SRS §6.11).
NEXT_PUBLIC_FEATURE_INVENTORY=false

# Mock mode only: the "business today" the demo data is built around.
NEXT_PUBLIC_MOCK_TODAY=2027-04-05
